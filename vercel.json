{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/login",
      "dest": "dist/server/server.js"
    },
    {
      "src": "/users/(.*)",
      "dest": "dist/server/server.js"
    },
    {
      "src": "/clients/(.*)",
      "dest": "dist/server/server.js"
    },
    {
      "src": "/invoices/(.*)",
      "dest": "dist/server/server.js"
    },
    {
      "src": "/products/(.*)",
      "dest": "dist/server/server.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "env": {
    "MONGODB_URI": "@mongodb-uri",
    "SESSION_SECRET": "@session-secret"
  }
}
